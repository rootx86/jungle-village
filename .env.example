# Copy to .env (never commit .env). No real secrets belong in this example file.

# --- Postgres (docker-compose.yml reads these too) ---
POSTGRES_USER=jungle
POSTGRES_PASSWORD=jungle
POSTGRES_DB=jungle
POSTGRES_PORT=5433
DATABASE_URL=postgres://jungle:jungle@localhost:5433/jungle

# --- Production (docker compose --profile app up -d --build) ---
# HTTP_PORT=8080                # where nginx listens
# POSTGRES_BIND=127.0.0.1       # never publish Postgres on a public interface
# RATE_LIMIT_PER_MIN=240        # per-IP limit for /api (admin routes: 30/min)
# MAX_SSE_CLIENTS=2000          # simultaneous live connections
# In production the API REFUSES to start unless ADMIN_TOKEN is 16+ random characters (not "change-me"),
# and SEED_DEMO defaults to false.

# --- VPS deployment (docker-compose.vps.yml); deploy/make-env.sh writes these on the server ---
# API_DOMAIN=api.example.com
# CORS_ORIGIN=https://your-site.pages.dev      (the website origin(s), comma separated)

# --- Backend ---
BACKEND_PORT=3001
CORS_ORIGIN=http://localhost:3000
CHANNEL_NAME=Old School Stories TV
# Protects /api/admin/* (send as x-admin-token header). Leave empty to disable the check (local only!).
ADMIN_TOKEN=change-me   # development only; use `openssl rand -hex 24` in production
# Insert 14 demo villagers of different ages when the database is empty. Set false for a real channel.
SEED_DEMO=true

# --- YouTube detection ---
# mock   = no credentials; use the admin simulate route (or MOCK_GROWTH_PROBABILITY)
# apikey = poll channels.list subscriberCount with an API key (default for a real channel)
# oauth  = subscriptions.list?mySubscribers=true as the channel owner (real subscribe dates)
YT_MODE=mock
YT_POLL_INTERVAL_SEC=300
# Villagers to import on the very first apikey poll (existing subscribers have no known date).
YT_BACKFILL_LIMIT=0
YT_MAX_SPAWN_PER_POLL=50

# apikey + oauth modes
YT_CHANNEL_ID=UCFZLzGrnth6TDH_Xyh_McBQ
YT_API_KEY=

# oauth mode only
YT_OAUTH_CLIENT_ID=
YT_OAUTH_CLIENT_SECRET=
YT_OAUTH_REFRESH_TOKEN=
YT_OAUTH_IMPORT_LIMIT=100

# mock mode only: chance per poll that 1-2 fake subscribers arrive (0 = never)
MOCK_GROWTH_PROBABILITY=0
MOCK_POLL_INTERVAL_SEC=10
